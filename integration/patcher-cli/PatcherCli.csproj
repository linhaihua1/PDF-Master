<?xml version="1.0" encoding="utf-8"?>
<!--
  PDFPatcher CLI 包装工程（.NET Framework 4.0，AnyCPU）。
  构建方式与前提见同目录 README.md。
  本工程未被本机验证：机器上缺少 .NET Framework 开发工具链。
-->
<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-1111-4222-8333-444455556666}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>PdfPatcherCli</RootNamespace>
    <AssemblyName>PDFPatcher.Cli</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\</OutputPath>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>PdfPatcherCli.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PatcherCli.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接引用上游可执行文件，复用其 Processor 层类型 -->
    <Reference Include="PDFPatcher">
      <HintPath>..\..\engines\pdfpatcher\bin\Release\PDFPatcher.exe</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MuPDFLib">
      <HintPath>..\..\engines\pdfpatcher\App\Lib\MuPDFLib.dll</HintPath>
    </Reference>
    <Reference Include="itextsharp">
      <HintPath>..\..\engines\pdfpatcher\App\Lib\itextsharp.dll</HintPath>
    </Reference>
    <Reference Include="iTextAsian">
      <HintPath>..\..\engines\pdfpatcher\App\Lib\iTextAsian.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
