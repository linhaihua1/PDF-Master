{
  "_comment": "对自动生成结果的手工覆盖：多文件端点字段名、输出类型、说明。key 为 capabilities.json 中的能力 id 前缀或完整 id。",
  "byEndpoint": {
    "/api/v1/general/merge-pdfs": {
      "files": [{ "field": "fileInput", "multiple": true, "required": true }],
      "output": "pdf",
      "options": [{ "name": "sortType", "type": "enum", "values": ["orderProvided", "byFileName", "byDateModified"], "default": "orderProvided" }]
    },
    "/api/v1/general/overlay-pdfs": {
      "files": [
        { "field": "baseFile", "multiple": false, "required": true },
        { "field": "overlayFiles", "multiple": true, "required": true }
      ],
      "output": "pdf",
      "options": [{ "name": "overlayPosition", "type": "enum", "values": ["0", "1", "2"], "default": "0" }]
    },
    "/api/v1/general/multi-page-layout": {
      "files": [{ "field": "fileInput", "multiple": true, "required": true }],
      "output": "pdf",
      "options": [
        { "name": "pagesPerSheet", "type": "int", "default": 2 },
        { "name": "addBorder", "type": "bool", "default": false }
      ]
    },
    "/api/v1/misc/add-image": {
      "files": [
        { "field": "fileInput", "multiple": false, "required": true },
        { "field": "imageFile", "multiple": false, "required": true }
      ],
      "output": "pdf"
    },
    "/api/v1/misc/add-stamp": {
      "files": [
        { "field": "fileInput", "multiple": false, "required": true },
        { "field": "stampImage", "multiple": false, "required": false }
      ],
      "output": "pdf"
    },
    "/api/v1/misc/add-attachments": {
      "files": [
        { "field": "fileInput", "multiple": false, "required": true },
        { "field": "attachments", "multiple": true, "required": true }
      ],
      "output": "pdf"
    },
    "/api/v1/misc/add-comments": {
      "files": [{ "field": "fileInput", "multiple": false, "required": true }],
      "output": "pdf"
    },
    "/api/v1/security/cert-sign": {
      "files": [
        { "field": "fileInput", "multiple": false, "required": true },
        { "field": "certFile", "multiple": false, "required": false }
      ],
      "output": "pdf",
      "note": "需要 PKCS12/JKS 证书与口令；未提供证书时此能力不可用"
    },
    "/api/v1/convert/file/pdf": {
      "files": [{ "field": "fileInput", "multiple": true, "required": true }],
      "output": "pdf",
      "note": "依赖内置 LibreOffice，首次转换较慢"
    },
    "/api/v1/convert/pdf/word": { "output": "docx" },
    "/api/v1/convert/pdf/xlsx": { "output": "xlsx" },
    "/api/v1/convert/pdf/csv": { "output": "csv" },
    "/api/v1/convert/pdf/img": { "output": "zip" },
    "/api/v1/convert/pdf/text": { "output": "txt" },
    "/api/v1/convert/pdf/html": { "output": "zip" },
    "/api/v1/convert/pdf/epub": { "output": "epub" },
    "/api/v1/convert/pdf/pdfa": { "output": "pdf" },
    "/api/v1/misc/extract-images": { "output": "zip" },
    "/api/v1/general/split-pages": { "output": "zip" },
    "/api/v1/misc/split-pdf-by-sections": { "output": "zip" },
    "/api/v1/general/split-pdf-by-chapters": { "output": "zip" },
    "/api/v1/general/split-by-size-or-count": { "output": "zip" },
    "/api/v1/misc/extract-attachments": { "output": "zip" },
    "/api/v1/general/extract-bookmarks": { "output": "xml" },
    "/api/v1/misc/list-attachments": { "output": "json" },
    "/api/v1/analysis/page-count": { "output": "json" },
    "/api/v1/analysis/basic-info": { "output": "json" },
    "/api/v1/analysis/document-properties": { "output": "json" },
    "/api/v1/analysis/page-dimensions": { "output": "json" },
    "/api/v1/analysis/form-fields": { "output": "json" },
    "/api/v1/analysis/annotation-info": { "output": "json" },
    "/api/v1/analysis/font-info": { "output": "json" },
    "/api/v1/analysis/security-info": { "output": "json" },
    "/api/v1/form/fields": { "output": "json" },
    "/api/v1/form/fields-with-coordinates": { "output": "json" },
    "/api/v1/form/extract-csv": { "output": "csv" },
    "/api/v1/form/extract-xlsx": { "output": "xlsx" }
  },
  "notes": {
    "defaultFilesField": "fileInput",
    "defaultOutput": "pdf",
    "asyncQuery": "?async=true 可切换为异步任务，随后轮询 GET /api/v1/general/job/{jobId}"
  }
}
